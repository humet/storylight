# Flat, npm-like node_modules (no symlinks). Required for sharp on Vercel:
# the serverless file tracer must resolve sharp's native libvips binary
# (@img/sharp-libvips-linux-x64) into the function bundle, and pnpm's default
# symlinked layout both hides it from the tracer and breaks Vercel's
# serverless packaging ("files in symlinked directories"). See BUILD_STATE.
node-linker=hoisted
